# Copy to .env.local (local) or set in your hosting panel (Hostinger / Vercel).
# Never commit real values.

# SMTP account that sends website inquiries (e.g. a Hostinger mailbox)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contact@qubryon.com
SMTP_PASS=

# Where inquiries are delivered
INQUIRY_TO=contact@qubryon.com
# Optional sender address (defaults to SMTP_USER)
INQUIRY_FROM=
